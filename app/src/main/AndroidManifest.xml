<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- アプリ一覧を取得するための権限 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- アプリの使用履歴（よく使うアプリ）を取得するための権限 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- カレンダーの予定を取得するための権限 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- PackageInstaller.uninstall() APIでアプリをアンインストールするための権限 -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- QUICK ACCESSの明るさ調整を端末全体に恒久的に反映するための権限（設定画面で手動許可） -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- オンボーディングで、バッテリー最適化の対象からの除外を直接リクエストするための権限 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GridLauncher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GridLauncher"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- 以下の2行でホームアプリ(ランチャー)として認識させます -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- PackageInstaller.uninstall() の結果通知を受け取るためのレシーバー -->
        <receiver android:name=".UninstallResultReceiver" android:exported="false" />

        <!-- 通知監視サービス -->
        <service android:name=".util.CyberNotificationListener"
            android:label="Cyber Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- QUICK ACCESSの電源ボタンから電源メニューを開くためだけのアクセシビリティサービス -->
        <service android:name=".util.PowerMenuAccessibilityService"
            android:label="GridLauncher Power Menu"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/power_menu_accessibility_service" />
        </service>
    </application>

</manifest>